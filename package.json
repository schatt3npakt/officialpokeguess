{
  "name": "pokeguess",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Pokemon Guess! - buildless web components app, deployable to any static host (www/).",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write \"www/**/*.{js,css,html}\" \"tools/**/*.mjs\" \"test/**/*.js\"",
    "sw": "node tools/build-sw-manifest.mjs",
    "images": "sh tools/convert-images.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
